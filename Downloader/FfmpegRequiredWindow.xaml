<Window x:Class="Downloader.FfmpegRequiredWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FFmpeg gerekli" Height="300" Width="500" MinHeight="300" MinWidth="500"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#F4F6FA">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="FFmpeg bulunamadı" FontSize="20" FontWeight="Bold" Foreground="#1D2940" />
        <TextBlock Grid.Row="1" Text="Seçilen video ve ses biçimlerini birleştirmek için FFmpeg gereklidir. Windows sürümünü indirin, ffmpeg.exe klasörünü PATH'e ekleyin ve uygulamayı yeniden başlatın."
                   FontSize="13" Foreground="#526078" TextWrapping="Wrap" Margin="0,12,0,14" />
        <TextBlock Grid.Row="2" VerticalAlignment="Top" FontSize="13">
            <Run Text="FFmpeg indirme adresi: " />
            <Hyperlink NavigateUri="https://github.com/BtbN/FFmpeg-Builds/releases"
                       RequestNavigate="DownloadLink_RequestNavigate">
                <Run Text="https://github.com/BtbN/FFmpeg-Builds/releases" />
            </Hyperlink>
        </TextBlock>
        <TextBlock Grid.Row="3" FontSize="13" Margin="0,14,0,0">
            <Run Text="İndirdikten sonra kurulum aşamaları için: " />
            <Hyperlink NavigateUri="https://www.youtube.com/watch?v=eRZRXpzZfM4"
                       RequestNavigate="DownloadLink_RequestNavigate">
                <Run Text="kurulum videosunu izleyin" />
            </Hyperlink>
        </TextBlock>
        <Grid Grid.Row="4">
            <Button Content="ffmpeg.exe konumunu seç" Width="190" Height="36" HorizontalAlignment="Left"
                    Background="White" Foreground="#26334D" BorderBrush="#E2E7F0"
                    Click="ChooseFfmpegButton_Click" />
            <Button Content="Kapat" Width="90" Height="36" HorizontalAlignment="Right"
                    Background="#536DFE" Foreground="White" BorderThickness="0" IsDefault="True"
                    Click="CloseButton_Click" />
        </Grid>
    </Grid>
</Window>
