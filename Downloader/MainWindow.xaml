<Window x:Class="Downloader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Downloader"
        mc:Ignorable="d"
        Title="Neko Downloader" Height="850" Width="1200" MinHeight="680" MinWidth="960"
        Background="#F4F6FA" WindowStartupLocation="CenterScreen"
        FontFamily="Roboto Slab">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#536DFE" />
        <SolidColorBrush x:Key="MutedBrush" Color="#8490A5" />
        <Style x:Key="GlassCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#D9FFFFFF" />
            <Setter Property="BorderBrush" Value="#99FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#273B63" BlurRadius="22" ShadowDepth="5" Opacity="0.12" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="44" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#B9C3D7" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontFamily" Value="Roboto Slab" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="PreviewButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="48" />
            <Setter Property="MinWidth" Value="168" />
            <Setter Property="Padding" Value="24,0" />
            <Setter Property="Background" Value="#EEF1FF" />
            <Setter Property="Foreground" Value="#465CE0" />
            <Setter Property="BorderBrush" Value="#D9DEFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Roboto Slab" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E1E7FF" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#BFC9FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#D3DCFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GlassActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#D9EEF1FF" />
            <Setter Property="Foreground" Value="#465CE0" />
            <Setter Property="BorderBrush" Value="#D9D9DEFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinWidth" Value="168" />
            <Setter Property="Padding" Value="24,0" />
            <Setter Property="Height" Value="48" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontFamily" Value="Roboto Slab" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                            <Border.Effect>
                                <DropShadowEffect Color="#273B63" BlurRadius="16" ShadowDepth="4" Opacity="0.16" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E6E1E7FF" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#8095FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#D6DFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#F1F4FB">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Width="430" Height="340" HorizontalAlignment="Right" VerticalAlignment="Top"
                     Margin="0,-150,-100,0" Fill="#66536DFE" Opacity="0.48">
                <Ellipse.Effect><BlurEffect Radius="85" /></Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="380" Height="320" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                     Margin="180,0,0,-140" Fill="#5544BBA4" Opacity="0.42">
                <Ellipse.Effect><BlurEffect Radius="90" /></Ellipse.Effect>
            </Ellipse>
        </Grid>
        <Border Grid.Column="0" Background="#E6172238" BorderBrush="#33FFFFFF" BorderThickness="0,0,1,0">
            <DockPanel Margin="20,24">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="4,0,0,38">
                        <Border Width="52" Height="52" Background="Transparent" BorderThickness="0">
                            <Image Source="pack://application:,,,/Ekran-görüntüsü-2026-10-29-190808.ico"
                                   Width="48" Height="48" Stretch="Uniform" />
                        </Border>
                        <TextBlock Text="Neko Downloader" Foreground="White" FontSize="13" FontWeight="Bold"
                                   VerticalAlignment="Center" Margin="8,0,0,0" FontFamily="Roboto Slab" />
                    </StackPanel>
                    <Button x:Name="DownloadsNavButton" Style="{StaticResource NavButtonStyle}"
                            Click="DownloadsNavButton_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="📥" Width="28"/><TextBlock Text="İndirmeler"/></StackPanel>
                    </Button>
                    <Button x:Name="CompletedNavButton" Style="{StaticResource NavButtonStyle}"
                            Click="CompletedNavButton_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="✓" Width="28"/><TextBlock Text="Tamamlandı"/></StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,4">
                    <Separator Background="#34415A" Margin="0,0,0,14" />
                    <Button x:Name="SettingsNavButton" Style="{StaticResource NavButtonStyle}"
                            Click="SettingsNavButton_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="⚙" Width="28"/><TextBlock Text="Ayarlar"/></StackPanel>
                    </Button>
                    <TextBlock Text="Sürüm 1.0" Foreground="#73809A" FontSize="11" Margin="12,14,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid x:Name="DownloadsPage" Grid.Column="1" Margin="30,22,30,22">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,16">
                <StackPanel><TextBlock Text="İndirmeler" FontSize="32" FontWeight="Bold" Foreground="#1D2940" FontFamily="Roboto Slab"/><TextBlock Text="Video ve toplu indirme kuyruğu" FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" FontFamily="Roboto Slab"/></StackPanel>
                <StackPanel HorizontalAlignment="Right" Width="260">
                    <Button x:Name="CheckUpdateButton" Content="yt-dlp güncellemesini denetle" Height="34" Background="White" Foreground="#26334D" BorderBrush="#E2E7F0" Click="CheckUpdateButton_Click" FontFamily="Roboto Slab" FontSize="12"/>
                    <TextBlock x:Name="StatusText" Text="Hazır" Foreground="#526078" FontSize="12" TextWrapping="Wrap" TextAlignment="Right" Margin="0,5,2,0" FontFamily="Roboto Slab"/>
                </StackPanel>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource GlassCardStyle}" CornerRadius="16" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Yeni indirme" FontSize="17" FontWeight="SemiBold" Foreground="#26334D" Margin="0,0,0,9" FontFamily="Roboto Slab"/>
                            <TextBox x:Name="UrlTextBox" Height="68" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="11" FontSize="12" Foreground="#526078" BorderBrush="#E2E7F0" ToolTip="Bir veya daha fazla URL (her satıra bir bağlantı)" FontFamily="Roboto Slab"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,9,0,0">
                                <Button x:Name="LoadFormatsButton" Content="Önizle" Style="{StaticResource PreviewButtonStyle}" Click="LoadFormatsButton_Click"/>
                            </StackPanel>
                            <Border x:Name="PreviewPanel" Visibility="Collapsed" Background="#BFFFFFFF" BorderBrush="#66FFFFFF" BorderThickness="1" CornerRadius="12" Padding="10" Margin="0,10,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Image x:Name="PreviewImage" Width="160" Height="90" Stretch="UniformToFill" Margin="0,0,12,0"/>
                                    <StackPanel VerticalAlignment="Center"><TextBlock x:Name="PreviewTitleText" FontWeight="SemiBold" Foreground="#26334D" TextWrapping="Wrap" MaxWidth="300" FontFamily="Roboto Slab" FontSize="12"/><TextBlock x:Name="PreviewDetailsText" Foreground="#8490A5" FontSize="11" Margin="0,4,0,0" FontFamily="Roboto Slab"/></StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                    <Border x:Name="MediaOptionsPanel" Visibility="Collapsed" Style="{StaticResource GlassCardStyle}" CornerRadius="16" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Medya seçenekleri" FontSize="17" FontWeight="SemiBold" Foreground="#26334D" Margin="0,0,0,10" FontFamily="Roboto Slab"/>
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="Video Formatı" Foreground="#526078" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8" FontFamily="Roboto Slab"/>
                                    <ComboBox x:Name="VideoFormatComboBox" Height="38" FontFamily="Roboto Slab" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="Ses Formatı" Foreground="#526078" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8" FontFamily="Roboto Slab"/>
                                    <ComboBox x:Name="AudioFormatComboBox" Height="38" FontFamily="Roboto Slab" FontSize="11"/>
                                </StackPanel>
                            </UniformGrid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                                <Button x:Name="DownloadButton" Content="Kuyruğa ekle" Style="{StaticResource GlassActionButtonStyle}"
                                        Click="DownloadButton_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Grid Margin="0,0,0,8"><TextBlock Text="İndirme kuyruğu" FontSize="18" FontWeight="SemiBold" Foreground="#26334D" VerticalAlignment="Center" FontFamily="Roboto Slab"/></Grid>
                    <ItemsControl x:Name="QueueItemsControl">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Border Style="{StaticResource GlassCardStyle}" CornerRadius="13" Padding="12" Margin="0,0,0,8">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#26334D" TextTrimming="CharacterEllipsis" FontSize="12" FontFamily="Roboto Slab"/><ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding Progress}" Margin="0,7,0,5"/><TextBlock Text="{Binding Details}" FontSize="11" Foreground="#8490A5" TextTrimming="CharacterEllipsis" FontFamily="Roboto Slab"/></StackPanel>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Status}" FontSize="11" Foreground="#526078" HorizontalAlignment="Center" FontFamily="Roboto Slab"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                                            <Button Content="⏸" Tag="{Binding}" ToolTip="Duraklat" Click="PauseQueueItemButton_Click" Width="32" Height="32" Padding="0" Margin="0,0,4,0" Background="#FFF5E8" BorderBrush="#F1DFC2" BorderThickness="1" Foreground="#A66A13" Cursor="Hand" FontFamily="Roboto Slab" FontSize="12"/>
                                            <Button Content="▶" Tag="{Binding}" ToolTip="Devam et" Click="ResumeQueueItemButton_Click" Width="32" Height="32" Padding="0" Margin="0,0,4,0" Background="#EAF7EF" BorderBrush="#CEE9D7" BorderThickness="1" Foreground="#23804A" Cursor="Hand" FontFamily="Roboto Slab" FontSize="12"/>
                                            <Button Content="✕" Tag="{Binding}" ToolTip="Kaldır" Click="RemoveQueueItemButton_Click" Width="32" Height="32" Padding="0" Margin="0" Background="#FFF0F1" BorderBrush="#F5D5D8" BorderThickness="1" Foreground="#C64752" Cursor="Hand" FontFamily="Roboto Slab" FontSize="14" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="CompletedPage" Grid.Column="1" Margin="30,22,30,22" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Tamamlanan indirmeler" FontSize="30" FontWeight="Bold"
                           Foreground="#1D2940" FontFamily="Roboto Slab" />
                <TextBlock Text="Başarıyla indirilen dosyalar burada listelenir."
                           FontSize="13" Foreground="{StaticResource MutedBrush}"
                           Margin="0,5,0,0" FontFamily="Roboto Slab" />
            </StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="CompletedItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource GlassCardStyle}" CornerRadius="13"
                                    Padding="14" Margin="0,0,0,9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="13"
                                                   FontWeight="SemiBold" Foreground="#26334D"
                                                   TextTrimming="CharacterEllipsis" FontFamily="Roboto Slab" />
                                        <TextBlock Text="{Binding Details}" FontSize="11"
                                                   Foreground="#8490A5" Margin="0,5,0,0"
                                                   TextTrimming="CharacterEllipsis" FontFamily="Roboto Slab" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="✓ Tamamlandı" Foreground="#23804A" FontSize="11"
                                                   VerticalAlignment="Center" Margin="0,0,12,0" FontFamily="Roboto Slab" />
                                        <Button Tag="{Binding}" ToolTip="İndirilen klasörü Dosya Gezgini'nde aç"
                                                Click="OpenDownloadLocationButton_Click" Width="32" Height="32"
                                                Padding="0" Margin="0,0,6,0" Background="#EEF1FF"
                                                BorderBrush="#D9DEFF" BorderThickness="1" Cursor="Hand">
                                            <Path Data="M3,6 L9,6 L11,8 L21,8 L21,19 L3,19 Z"
                                                  Fill="#536DFE" Width="16" Height="16"
                                                  Stretch="Uniform" />
                                        </Button>
                                        <Button Content="✕" Tag="{Binding}" ToolTip="Listeden kaldır"
                                                Click="RemoveQueueItemButton_Click" Width="32" Height="32"
                                                Padding="0" Background="#FFF0F1" BorderBrush="#F5D5D8"
                                                BorderThickness="1" Foreground="#C64752" Cursor="Hand"
                                                FontFamily="Roboto Slab" FontSize="14" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="SettingsPage" Grid.Column="1" Margin="36,28,36,28" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,26">
                <TextBlock Text="Ayarlar" FontSize="36" FontWeight="Bold" Foreground="#1D2940" FontFamily="Roboto Slab" />
                <TextBlock Text="İndirme tercihlerinizi buradan düzenleyin." FontSize="13"
                           Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" FontFamily="Roboto Slab" />
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource GlassCardStyle}" CornerRadius="16" Padding="20"
                    VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="İndirme ayarları" FontSize="17" FontWeight="SemiBold"
                               Foreground="#26334D" FontFamily="Roboto Slab" />
                    <TextBlock Text="Dosyaların kaydedileceği klasörü seçin. Bu tercih sonraki açılışlarda da kullanılır."
                               FontSize="12" Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" Margin="0,7,0,18" FontFamily="Roboto Slab" />
                    <TextBlock Text="Kaydetme konumu" Foreground="#526078" FontSize="13"
                               FontWeight="SemiBold" Margin="2,0,0,8" FontFamily="Roboto Slab" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="DownloadDirectoryTextBox" Height="38"
                                 VerticalContentAlignment="Center" Padding="11,0" FontSize="12"
                                 Foreground="#526078" BorderBrush="#E2E7F0" IsReadOnly="True" FontFamily="Roboto Slab" />
                        <Button x:Name="BrowseDownloadDirectoryButton" Grid.Column="1" Content="Gözat..."
                                Height="38" Padding="16,0" Margin="10,0,0,0" Background="#F4F6FA"
                                Foreground="#26334D" BorderBrush="#E2E7F0"
                                Click="BrowseDownloadDirectoryButton_Click" Cursor="Hand" FontFamily="Roboto Slab" FontSize="12" FontWeight="SemiBold" />
                    </Grid>
                    <TextBlock Text="Eşzamanlı indirme sayısı" Foreground="#526078" FontSize="13" FontWeight="SemiBold" Margin="2,18,0,8" FontFamily="Roboto Slab" />
                    <ComboBox x:Name="ConcurrencyComboBox" Height="38" SelectedIndex="1" SelectionChanged="ConcurrencyComboBox_SelectionChanged" FontFamily="Roboto Slab" FontSize="12">
                        <ComboBoxItem Content="1 (Sırayla)" Tag="1"/>
                        <ComboBoxItem Content="2" Tag="2"/>
                        <ComboBoxItem Content="3" Tag="3"/>
                        <ComboBoxItem Content="4" Tag="4"/>
                    </ComboBox>
                    <TextBlock x:Name="SettingsStatusText" Foreground="{StaticResource MutedBrush}"
                               FontSize="12" TextWrapping="Wrap" Margin="2,10,0,0" FontFamily="Roboto Slab" />
                </StackPanel>
            </Border>
        </Grid>
        <Border x:Name="NotificationBanner" Grid.ColumnSpan="2" Panel.ZIndex="10"
                Width="520" MaxWidth="600" HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,24,0,0" Visibility="Collapsed" Opacity="0"
                Background="#D9E7F5EC" BorderBrush="#AAFFFFFF" BorderThickness="1"
                CornerRadius="12" Padding="12" IsHitTestVisible="False">
            <Border.RenderTransform>
                <TranslateTransform x:Name="NotificationTransform" Y="-30" />
            </Border.RenderTransform>
            <TextBlock x:Name="NotificationText" Foreground="#245B37" TextWrapping="Wrap"
                       FontSize="12" FontFamily="Roboto Slab" />
        </Border>
    </Grid>
</Window>
